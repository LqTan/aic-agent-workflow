            {
              "id": "a4",
              "name": "quality_threshold",
              "value": "={{ $json.body.quality_threshold || $json.quality_threshold || 0.42 }}",
              "type": "number"
            },
            {
              "id": "a5",
              "name": "attempt",
              "value": "=1",
              "type": "number"
            },
            {
              "id": "a6",
              "name": "max_attempts",
              "value": "={{ $json.body.max_attempts || $json.max_attempts || 2 }}",
