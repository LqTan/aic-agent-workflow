    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "current_query",
              "value": "={{ $json.body.query || $json.query }}",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "collection_ids",
              "value": "={{ $json.body.collection_ids || $json.collection_ids || [] }}",
              "type": "array"
            },
            {
              "id": "a3",
              "name": "top_k",
              "value": "={{ $json.body.top_k || $json.top_k || 12 }}",
              "type": "number"
