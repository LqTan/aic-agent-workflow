# Production compose reads this file. Copy to .env and edit before `up -d --build`.
# All values below already have defaults in docker/production/docker-compose.yml,
# so this file is OPTIONAL — only fill in what you want to override.

# --- Database ---
POSTGRES_DB=aic
POSTGRES_USER=aic
POSTGRES_PASSWORD=aic
POSTGRES_PORT=5433

# --- Backend ports & CORS ---
BACKEND_PORT=8000
APP_CORS_ORIGINS=http://103.200.22.67:3001
APP_LOG_LEVEL=INFO

# --- Frontend build-time (passed via ARG, baked into Next.js bundle) ---
FRONTEND_PORT=3001
NEXT_PUBLIC_API_BASE_URL=http://103.200.22.67:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# --- Search engine ---
# Default OFF so the hybrid index actually runs. Flip to `true` to bypass
# torch + open_clip_torch (e.g. when running with the demo dataset).
KIS_DEMO_MODE=false

KIS_EMBEDDING_PROVIDER=remote
KIS_EMBEDDING_URL=
KIS_EMBEDDING_API_KEY=

# --- LLM planner (OpenAI-compatible) ---
# Leave empty to use the offline deterministic planner.
KIS_LLM_API_KEY=
KIS_LLM_ENDPOINT=
KIS_LLM_MODEL=

# --- n8n ---
N8N_PORT=5678
