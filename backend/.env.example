# Database
DATABASE_URL=postgresql+psycopg://aic:aic@db:5432/aic

# Search engine (matches docker-compose volume mounts)
KIS_DATA_ROOT=/data/aic
KIS_INDEX_ROOT=/data/search_index
KIS_DOMAIN_TAXONOMY=/data/search_index/taxonomy.json
KIS_DEMO_MODE=true
KIS_CLIP_MODEL=ViT-B-32
KIS_CLIP_PRETRAINED=openai

# Planner LLM (OpenAI-compatible). Leave empty to use local deterministic planner.
KIS_LLM_API_KEY=
KIS_LLM_ENDPOINT=
KIS_LLM_MODEL=

# Limits
KIS_MAX_VIDEO_SIZE=2147483648

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
