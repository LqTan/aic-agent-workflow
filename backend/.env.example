# Database
DATABASE_URL=postgresql+psycopg://aic:aic@localhost:5433/aic

# Search engine — paths point at the AIC dataset under root data/
KIS_DATA_ROOT=./data
KIS_INDEX_ROOT=./data/search_index
KIS_DOMAIN_TAXONOMY=./data/search_index/taxonomy.json

# Demo mode (skips torch + open_clip_torch). Set false to use the real
# hybrid R-tree index built from data/{clip-features-32,keyframes,objects,videos}.
KIS_DEMO_MODE=false

# KIS_DEMO_MODE=true keeps these unused but documented:
KIS_CLIP_MODEL=ViT-B-32
KIS_CLIP_PRETRAINED=openai

# Remote embedding service
KIS_EMBEDDING_PROVIDER=remote
KIS_EMBEDDING_URL=http://localhost:9000
KIS_EMBEDDING_API_KEY=

# Planner LLM (OpenAI-compatible). Leave empty to use local deterministic planner.
KIS_LLM_API_KEY=
KIS_LLM_ENDPOINT=
KIS_LLM_MODEL=

# Limits
KIS_MAX_VIDEO_SIZE=2147483648

# App
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000
