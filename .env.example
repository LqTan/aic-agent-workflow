# Docker Compose
POSTGRES_DB=base_platform
POSTGRES_USER=base_platform
POSTGRES_PASSWORD=base_platform
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_PORT=5433
REDIS_PORT=6380

# KIS integration
KIS_DATA_ROOT=/data/aic
KIS_INDEX_ROOT=/app/search_engine/data/search_index
KIS_DATA_ROOT_HOST=./BE/data_processing
KIS_INDEX_ROOT_HOST=./BE/search_engine/data/search_index
KIS_SEARCH_FUNCTION=search_engine.kis.search
KIS_INSPECT_FUNCTION=search_engine.kis.inspect
KIS_MAX_VIDEO_SIZE=2147483648

# Optional OpenAI-compatible planner (MiniMax or another provider).
# Leave blank to use the deterministic offline planner for the demo.
KIS_LLM_API_KEY=
KIS_LLM_ENDPOINT=
KIS_LLM_MODEL=
N8N_PORT=5678
