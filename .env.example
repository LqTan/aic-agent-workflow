# --- Database ---
POSTGRES_DB=aic
POSTGRES_USER=aic
POSTGRES_PASSWORD=aic
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://aic:aic@localhost:5433/aic

# --- Backend ---
BACKEND_PORT=8000
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
FRONTEND_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_USE_MOCKS=false

# --- KIS Video Search Engine ---
KIS_DATA_ROOT=./data
KIS_INDEX_ROOT=./data/search_index
KIS_DOMAIN_TAXONOMY=./data/search_index/taxonomy.json
KIS_DEMO_MODE=false
KIS_CLIP_MODEL=ViT-B-32
KIS_CLIP_PRETRAINED=openai
KIS_EMBEDDING_PROVIDER=onnx
KIS_EMBEDDING_URL=
KIS_EMBEDDING_API_KEY=
KIS_MAX_VIDEO_SIZE=2147483648

# --- LLM Planner (OpenAI-compatible) ---
# Leave blank to use local deterministic offline planner.
KIS_LLM_API_KEY=
KIS_LLM_ENDPOINT=
KIS_LLM_MODEL=

# --- n8n ---
N8N_PORT=5678
